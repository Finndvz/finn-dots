#!/usr/bin/env bash
# finn - Dotfiles management CLI

DOTS_DIR="$HOME/.finn-dots"
CMD_DIR="$DOTS_DIR/.data/finn-cli/commands"

cmd="${1:-help}"
[[ "$cmd" == "--help" || "$cmd" == "-h" ]] && cmd="help"
shift 2>/dev/null || true

cmd_file="$CMD_DIR/$cmd.sh"
if [[ -f "$cmd_file" ]]; then
    # Run inside a function so 'local' and 'return' work in sourced files
    _finn_run() {
        source "$cmd_file" "$@"
    }
    _finn_run "$@"
else
    echo "finn: unknown command '$cmd'"
    echo "Run 'finn help' for usage information."
    exit 1
fi
